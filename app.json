{
  "expo": {
    "name": "Sattilik Taxi",
    "slug": "bolt-expo-nativewind",
    "version": "1.2.2.3",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "updates": {
      "enabled": false
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.asylkhansansuzbaev.sattiliktaxi.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0A1628"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A1628",
          "image": "./assets/images/logo_splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#0A1628",
            "image": "./assets/images/logo_splash.png",
            "imageWidth": 200,
            "resizeMode": "contain"
          }
        }
      ],
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Жақын жүргізушілерді табу үшін орналасқан жеріңіз қолданылады"
        }
      ]
    ],
    "splash": {
      "image": "./assets/images/logo_splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A1628"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "17041cd0-5bba-4be9-9065-a2edaefbb4ee"
      }
    },
    "owner": "sansuzbaev856ghjk"
  }
}
